generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Starter models — replace with your own
model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
  posts Post[]
}

model Post {
  id        Int     @id @default(autoincrement())
  title     String
  content   String?
  published Boolean @default(false)
  authorId  Int
  author    User    @relation(fields: [authorId], references: [id])
}

model Project {
  id            String         @id @default(uuid())
  name          String
  ownerUserId   String         @map("owner_user_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  conversations     Conversation[]
  documents         Document[]
  promptExperiments PromptExperiment[]

  @@index([ownerUserId])
  @@map("projects")
}

model Conversation {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  ownerUserId String    @map("owner_user_id")
  title       String
  createdAt   DateTime  @default(now()) @map("created_at")
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([projectId])
  @@index([ownerUserId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  role           String
  content        String
  route          String?
  status         String?
  provider       String?
  model          String?
  citationsJson  String?      @map("citations_json")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Document {
  id             String          @id @default(uuid())
  projectId      String          @map("project_id")
  ownerUserId    String          @map("owner_user_id")
  filename       String
  contentType    String          @map("content_type")
  sizeBytes      Int             @map("size_bytes")
  checksum       String?
  storageKey     String          @map("storage_key")
  pageCount      Int?            @map("page_count")
  status         String          @default("uploaded")
  failureCode    String?         @map("failure_code")
  failureMessage String?         @map("failure_message")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks         DocumentChunk[]

  @@index([projectId, status])
  @@index([ownerUserId])
  @@map("documents")
}

model DocumentChunk {
  id                 String                       @id @default(uuid())
  projectId          String                       @map("project_id")
  documentId         String                       @map("document_id")
  ordinal            Int
  content            String
  pageStart          Int?                         @map("page_start")
  pageEnd            Int?                         @map("page_end")
  charStart          Int?                         @map("char_start")
  charEnd            Int?                         @map("char_end")
  embeddingModel     String                       @map("embedding_model")
  embeddingDimension Int                          @map("embedding_dimension")
  // pgvector column; queried via SQLAlchemy / raw SQL, not Prisma Client.
  embedding          Unsupported("vector(768)")?
  createdAt          DateTime                     @default(now()) @map("created_at")
  document           Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordinal])
  @@index([projectId, documentId])
  @@map("document_chunks")
}

model PromptExperiment {
  id                       String   @id @default(uuid())
  runId                    String   @map("run_id")
  projectId                String   @map("project_id")
  ownerUserId              String   @map("owner_user_id")
  userInput                String   @map("user_input")
  strategy                 String
  templateVersion          String   @map("template_version")
  model                    String
  provider                 String
  generatedOutput          String   @map("generated_output")
  elapsedMs                Int      @map("elapsed_ms")
  promptTokens             Int?     @map("prompt_tokens")
  completionTokens         Int?     @map("completion_tokens")
  totalTokens              Int?     @map("total_tokens")
  ratingAccuracy           Int?     @map("rating_accuracy")
  ratingClarity            Int?     @map("rating_clarity")
  ratingResearchUsefulness Int?     @map("rating_research_usefulness")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")
  project                  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([ownerUserId])
  @@index([runId])
  @@map("prompt_experiments")
}
