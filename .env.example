# Shared / publicly safe
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# AI service
APP_ENV=development
LOG_LEVEL=INFO
# Prisma Postgres connection string (also used by the FastAPI AI service).
# Keep this in root `.env` and `apps/web/.env` (prisma postgres link writes the web copy).
# Never commit real values. Never use NEXT_PUBLIC_* for database URLs.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
CORS_ORIGINS=http://localhost:3000

# LLM — Google Gemini (server-side only; never NEXT_PUBLIC_*)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
# Optional alias for the same secret:
LLM_API_KEY=
LLM_TIMEOUT_MS=30000
# Set true only for local demos when Gemini quota is exhausted (never in production)
DEV_FAKE_LLM=false

# Embeddings — used from Task 2
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004

STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
WEB_SEARCH_API_KEY=
WEATHER_API_KEY=
MAX_UPLOAD_BYTES=20971520
