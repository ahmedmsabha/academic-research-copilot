# Shared / publicly safe
# Local `next dev`: browser and the Next.js proxy both use this origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Docker/Dokploy web container: AI origin as reachable from that container (no /api suffix).
# API_BASE_URL=http://ai-service:8000

# AI service
# Use production only on a real host. Fake providers are rejected when APP_ENV=production.
APP_ENV=development
LOG_LEVEL=INFO
# Prisma Postgres connection string (also used by the FastAPI AI service).
# Keep this in root `.env` and `apps/web/.env` (prisma postgres link writes the web copy).
# Never commit real values. Never use NEXT_PUBLIC_* for database URLs.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Local: localhost. Production (Fly secret): https://your-app.vercel.app — no trailing slash.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM — Google Gemini (server-side only; never NEXT_PUBLIC_*)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-lite-latest
GEMINI_API_KEY=
# Optional alias for the same secret:
LLM_API_KEY=
LLM_TIMEOUT_MS=30000
# Set true only for local demos when Gemini quota is exhausted (never in production)
DEV_FAKE_LLM=false

# Embeddings — Gemini gemini-embedding-001 (768 dims via output_dimensionality)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_TIMEOUT_MS=60000
EMBEDDING_BATCH_SIZE=1
EMBEDDING_BATCH_PAUSE_MS=1500
# Set true only for local demos when embedding quota is exhausted (never in production)
DEV_FAKE_EMBEDDINGS=false

# Local PDF object storage (Task 2 default). R2/Supabase can replace this later.
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=.data/uploads
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Upload / chunking / retrieval
MAX_UPLOAD_BYTES=20971520
MAX_DOCUMENTS_PER_PROJECT=20
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=150
# Long books exceed Gemini free/dev embedding quota. Prefer a chapter or paper.
MAX_INDEX_CHUNKS=400
# Tesseract OCR fallback when PyMuPDF finds no text layer (scanned PDFs).
ENABLE_OCR=true
OCR_LANGUAGE=eng
OCR_DPI=150
RETRIEVAL_TOP_K=5
# Cosine distance upper bound (1 - similarity). Lower is stricter.
RETRIEVAL_MAX_DISTANCE=0.55
RETRIEVAL_RELAXED_MAX_DISTANCE=0.78

# Agent tools (Task 3)
# Weather uses Open-Meteo (no key). WEB_SEARCH_API_KEY enables Tavily.
# Without Tavily, DuckDuckGo HTML search is used (real ranked links). Instant Answer
# and Gemini Google Search grounding are later fallbacks — Gemini shares chat quota.
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_MS=12000
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_GEMINI_MODEL=gemini-flash-latest
WEATHER_TIMEOUT_MS=10000
CALCULATOR_MAX_EXPRESSION_CHARS=200
WEATHER_API_KEY=
